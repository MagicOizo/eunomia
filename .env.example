# Copy this file to .env and fill in real values.
# NEVER commit the real .env — it is gitignored on purpose.
#
# Generate the secrets below with openssl (available on virtually every host):
#   openssl rand -base64 64     # JWT_SECRET (>= 32 bytes, 64 recommended)
#   openssl rand -base64 24     # DB_PASSWORD, SETUP_TOKEN

# Which published image to run (a release tag like 0.1.0, or 'latest').
# See the packages at ghcr.io/magicoizo/eunomia. Pin a version for production.
EUNOMIA_VERSION=latest

# development | production
# 'production' marks the refresh-token cookie as Secure (HTTPS-only) and enforces
# a minimum JWT_SECRET length — keep it 'production' for any real deployment.
NODE_ENV=production

# Port the app listens on (also the host port mapping in docker-compose.yml).
PORT=3000

# --- Database ---
# The API connects as this dedicated application user (never root), and the
# MariaDB container is bootstrapped from these same values (see
# docker-compose.yml) — so credentials are defined only once here. Root gets a
# throwaway random password nobody needs. DB_HOST is the db compose service name.
DB_HOST=db
DB_PORT=3306
DB_USER=eunomia
DB_PASSWORD=
DB_NAME=eunomia

# --- Authentication ---
# JWT_SECRET signs the short-lived access tokens; rotating it invalidates all
# existing sessions. Use at least 32 bytes of randomness (64 recommended):
#   openssl rand -base64 64
JWT_SECRET=
# Access-token lifetime (short) and refresh-token lifetime (long), in seconds.
# Defaults: 15 min access, 30 days refresh.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# One-time bootstrap token for creating the first admin via POST /api/v1/setup.
# Setup only works while no user exists AND this token is sent (header
# X-Setup-Token). Set it before first start, then remove it afterwards to
# disable the setup endpoint entirely.  openssl rand -base64 24
SETUP_TOKEN=

# --- Reverse proxy & rate limiting ---
# The app runs behind a TLS-terminating reverse proxy (e.g. Traefik). TRUST_PROXY
# is the number of proxy hops in front of it, so the real client IP (from
# X-Forwarded-For) is used for rate limiting instead of the proxy's IP.
TRUST_PROXY=1
# Strict limit on the auth endpoints (login/refresh/setup) and a generous global
# limit on the rest of the API. All optional — these are the defaults.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
