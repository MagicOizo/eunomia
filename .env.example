# Copy this file to .env and fill in real values.
# NEVER commit the real .env — it is gitignored on purpose.

# Which published image to run (a release tag like 0.1.0, or 'latest').
# See the packages at ghcr.io/magicoizo/eunomia. Pin a version for production.
EUNOMIA_VERSION=latest

# development | production
# 'production' marks the refresh-token cookie as Secure (HTTPS-only) — keep
# this set to 'production' for any real deployment behind the reverse proxy.
NODE_ENV=production

# Port the app listens on inside its container.
PORT=3000

# --- API -> database connection ---
# The API connects as the dedicated application user below (never root).
# DB_HOST is the compose service name of the database container.
DB_HOST=db
DB_PORT=3306
DB_USER=eunomia
DB_PASSWORD=
DB_NAME=eunomia

# --- Authentication (Slice 3) ---
# JWT_SECRET signs the short-lived access tokens. Must be a long random string;
# rotating it invalidates all existing access tokens. Generate with the same
# command shown below for the database secrets.
JWT_SECRET=
# Access-token lifetime (short) and refresh-token lifetime (long), in seconds.
# Defaults: 15 min access, 30 days refresh.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# One-time bootstrap token for creating the first admin via POST /api/v1/setup.
# Setup only works while no user exists AND this token is sent (header
# X-Setup-Token). Set it before first start, then remove it afterwards to
# disable the setup endpoint entirely.
SETUP_TOKEN=

# --- Reverse proxy & rate limiting (Slice 10) ---
# The app runs behind a TLS-terminating reverse proxy (e.g. Traefik). TRUST_PROXY
# is the number of proxy hops in front of it, so the real client IP (from
# X-Forwarded-For) is used for rate limiting instead of the proxy's IP.
TRUST_PROXY=1
# Strict limit on the auth endpoints (login/refresh/setup) and a generous global
# limit on the rest of the API. All optional — these are the defaults.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MS=60000

# --- MariaDB container bootstrap ---
# MYSQL_DATABASE / MYSQL_USER / MYSQL_PASSWORD must match DB_NAME / DB_USER /
# DB_PASSWORD above — the container creates that user + schema on first start,
# and the API then connects with them.
#
# MYSQL_ROOT_PASSWORD must be set explicitly. Leaving it blank makes the
# MariaDB image generate a random root password and print it once to the
# container log — that is how the first attempt at this project ended up
# with an effectively unrecoverable root password (see Notes/eunomia-plan.md,
# 2.1). Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64'))"
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=eunomia
MYSQL_USER=eunomia
MYSQL_PASSWORD=
